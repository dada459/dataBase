#create table
mysql> CREATE TABLE Book(
    -> bookid numeric(8,0),
    -> bookname varchar(20),
    -> publisher varchar(20),
    -> price numeric(6,0),
    -> PRIMARY KEY(bookid));

mysql> CREATE TABLE Customer(
    -> custid numeric(8,0),
    -> name varchar(5),
    -> address varchar(10),
    -> phone varchar(13),
    -> PRIMARY KEY(custid));

mysql> CREATE TABLE Orders(
    -> orderid numeric(8,0),
    -> custid numeric(8,0),
    -> bookid numeric(8,0),
    -> saleprice numeric(10,0),
    -> orderdate DATE,
    -> PRIMARY KEY(orderid),
    -> foreign key(bookid) references Book(bookid));


